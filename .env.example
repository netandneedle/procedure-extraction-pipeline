# =============================================================================
# Databases
# =============================================================================
#
# Both passwords are REQUIRED. Docker Compose has no defaults for them and
# refuses to start until they are set, so a fresh clone cannot silently run
# on well-known dev credentials. Pick anything; they only ever travel over
# loopback (every port in docker-compose.yml is bound to 127.0.0.1).
#
# POSTGRES_DB / POSTGRES_USER / POSTGRES_PASSWORD / NEO4J_USER are read by
# Compose only (it builds DATABASE_URL and NEO4J_AUTH from them). Running the
# backend outside Docker? See the section at the bottom of this file.
#
# Neo4j reads NEO4J_PASSWORD on FIRST boot only. Changing it later does not
# change the password of an existing neo4jdata volume — you would be locked
# out of your own graph. To rotate, `docker compose down -v neo4j` first
# (this discards the graph; reload with scripts/load_attack.py).
POSTGRES_DB=pipeline
POSTGRES_USER=pipeline
POSTGRES_PASSWORD=CHANGE_ME

NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME
# Set true to enable distribute-node writes to Neo4j. Reversible per report:
#   docker compose exec -w /app api python -m scripts.undo_graph_source --list
# Keep the comment on its own line. Compose passes this straight through
# as ${NEO4J_WRITES_ENABLED}, and a trailing ' # ...' becomes part of the
# value — the flag then reads as false while looking set.
NEO4J_WRITES_ENABLED=false

# =============================================================================
# LLM
# =============================================================================
#
# Set the key for the provider you actually use. Only one is needed.
#   Anthropic: https://console.anthropic.com/settings/keys
#   OpenAI:    https://platform.openai.com/api-keys
# Real values belong in .env (gitignored), never in this template.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Create the Anthropic key INSIDE a workspace (pick the workspace in the
# console before "Create Key"). A key created at the organization level is
# rejected with "This API key is not scoped to a workspace" unless you also
# set the workspace it should bill to:
ANTHROPIC_WORKSPACE_ID=

# Upload size cap in bytes (default 50 MB). SECURITY.md describes the bound.
UPLOAD_MAX_BYTES=52428800

# Which vendor to call: "anthropic" (default) or "openai".
LLM_PROVIDER=anthropic

# -----------------------------------------------------------------------------
# THIS PIPELINE USES TWO MODELS ON PURPOSE. SET BOTH.
# -----------------------------------------------------------------------------
#
#   LLM_MODEL       Extraction. Called ~9x per source — entities, figures,
#                   chunking, technique propose+pick, drafting, feedback
#                   synthesis. This is where the bill lands. A MID-frontier
#                   model is the right tier; the top tier did not measurably
#                   improve extraction when compared head to head.
#
#   REVIEWER_MODEL  The AI gate reviewer. Called once per enabled gate. Should
#                   be a STRONGER and DIFFERENT model than LLM_MODEL.
#
# Why different: the reviewer exists to bring judgment the extraction pass did
# not. A reviewer running the same model as the extractor largely agrees with
# itself, and the agreement readout on the Reviewer tab then measures nothing
# while still looking healthy. That is a silent failure, so the app logs a
# warning at startup if the two are identical.
#
# Deliberately not a cross-vendor equivalence table here — model lineups move
# faster than this file does. What matters is the property: mid tier vs top
# reasoning tier, and distinct from each other.
#
#   Anthropic:  LLM_MODEL=claude-sonnet-5   REVIEWER_MODEL=claude-opus-5
#   OpenAI:     LLM_MODEL=<mid tier>        REVIEWER_MODEL=<top reasoning tier>
#
LLM_MODEL=claude-sonnet-5
REVIEWER_MODEL=claude-opus-5

# Run the reviewer on a DIFFERENT vendor than extraction. Empty = inherit
# LLM_PROVIDER. This is the strongest available form of reviewer independence.
REVIEWER_PROVIDER=

# Reasoning effort, on models that expose the knob.
#   Anthropic accepts: low | medium | high | max
#   OpenAI accepts:    none | minimal | low | medium | high | xhigh
# A value the provider doesn't accept is clamped to "high" with a warning
# rather than sent (it would be a 400). Inert on models with no reasoning tier.
#
# Blank is fine anywhere in this file: an empty value means "unset" and falls
# through to the default. (That includes the empty string Compose
# substitutes for a variable you left out of .env.)
LLM_EFFORT=high

# Point the "openai" provider at an OpenAI-COMPATIBLE endpoint instead of
# api.openai.com — Azure OpenAI, OpenRouter, Together, Groq, vLLM, Ollama,
# LM Studio. Empty uses the SDK default.
OPENAI_BASE_URL=

# Bump to invalidate every cached LLM response at once. Most changes need
# nothing — the system prompt is part of the cache key, so editing a prompt
# already invalidates it. This is for the cases where the prompt text is
# unchanged but the answer should not be (an ATT&CK catalogue upgrade that
# doesn't surface in the prompt; a deliberate re-sample after a model's
# serving behavior shifts under a stable model ID). There is intentionally
# no TTL.
LLM_CACHE_VERSION=1

# =============================================================================
# Technique retriever
# =============================================================================
#
# Embeddings need no key. The default retriever runs
# cisco-ai/SecureBERT2.0-biencoder locally: ~570 MB, downloaded on the FIRST
# technique-extraction call (not at `docker compose up`) and cached in the
# hf-cache volume. The feedback flywheel reuses the same model.
#
# No download, small disk, or slow link: "token_overlap" is a lexical
# retriever (Jaccard + CVE/tool anchors) that needs nothing. It loses a few
# lexically-distant matches; everything else in the pipeline is unchanged.
#   embedding (default) | token_overlap
TECHNIQUE_RETRIEVER=

# Optional: LangSmith observability
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=procedure-extraction-pipeline

# =============================================================================
# Running the backend OUTSIDE Docker (bare `uvicorn`)
# =============================================================================
#
# The backend reads backend/.env (its working directory), not this file.
# Compose normally derives the three values below; without it, set them
# yourself in backend/.env, alongside NEO4J_PASSWORD and your LLM key.
#
#   DATABASE_URL=postgresql+asyncpg://pipeline:<POSTGRES_PASSWORD>@localhost:5432/pipeline
#   NEO4J_URI=bolt://localhost:7687
#   # The default points inside the container; on the host it is the repo path:
#   ATTACK_STIX_PATH=/absolute/path/to/repo/data/attack/enterprise-attack-19.2.json
