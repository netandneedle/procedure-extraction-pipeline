# Environment
.env
*.env.local

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Node
node_modules/
dist/

# IDE
.vscode/
.idea/
*.swp
*.swo

# AI coding-assistant local state
.claude/

# Docker
.docker/

