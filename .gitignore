.DS_Store
Thumbs.db

# Test / coverage
.coverage
htmlcov/
.pytest_cache/

# Scratch / validation outputs
backend/tmp/
tmp/
.mount-probe-test

# ATT&CK STIX bundles — large (~54 MB each) and downloadable from MITRE on
# demand: scripts/fetch_attack.sh fetches the version the code is pinned to.
data/attack/enterprise-attack-*.json
data/attack/changelog-*.json

# Test sources — local-only CTI material for ad-hoc pipeline runs. The
# directory is tracked via .gitkeep so the path exists for fresh clones,
# but contents stay off-disk-of-record.
data/test-sources/*
!data/test-sources/.gitkeep

# Local calibration / capture outputs and browser-automation artefacts
backend/calib.*
.playwright-mcp/
/*.png
docs/*.pptx
docs/deck*

# Golden replay fixtures are captured pipeline state and carry text derived
# from the source report (technique source_quote, chunk summaries). They stay
# in the development tree; the tests that need one skip with a reason.
tests/golden/
